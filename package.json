{
	"name": "begonia",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:worker": "astro build && wrangler dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"db:migrate:local": "wrangler d1 migrations apply BLOG_DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply BLOG_DB --remote",
		"deploy": "astro build && wrangler deploy",
		"types:worker": "wrangler types",
		"check": "biome check .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint ."
	},
	"dependencies": {
		"astro": "^7.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"wrangler": "^4.124.0"
	}
}
