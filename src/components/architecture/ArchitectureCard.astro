---
import {
	type ArchitectureSummary,
	getArchitectureDetailUrl,
	getCloudLabel,
	getThemeLabel,
} from '../../utils/architectures';

interface Props {
	architecture: ArchitectureSummary;
	position: number;
}

const { architecture, position } = Astro.props;

const detailUrl = getArchitectureDetailUrl(architecture);
---

<a
	class:list={[
		'architecture-entry',
		`architecture-entry--${architecture.cloud}`,
		'architecture-entry--linked',
	]}
	href={detailUrl}
	aria-label={`${architecture.title}のケーススタディを読む`}
>
	<span class="architecture-entry__index">{String(position).padStart(2, '0')}</span>
	<div class="architecture-entry__provider">
		<strong>{getCloudLabel(architecture.cloud)}</strong>
		<span>{architecture.themes.map(getThemeLabel).join(' / ')}</span>
	</div>
	<div class="architecture-entry__body">
		<h3>{architecture.title}</h3>
		<p>{architecture.services.join(' · ')}</p>
	</div>
	<span class="architecture-entry__status">公開中</span>
	<span class="architecture-entry__arrow" aria-hidden="true">→</span>
</a>

<style>
	.architecture-entry {
		position: relative;
		display: grid;
		grid-template-columns: 3rem minmax(10rem, 13rem) minmax(0, 1fr) max-content 1.75rem;
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
		align-items: center;
		min-height: 6rem;
		border-bottom: 1px solid var(--border);
		padding: 0.8rem 0;
		color: inherit;
		text-decoration: none;
	}

	.architecture-entry::before {
		position: absolute;
		top: -1px;
		left: 0;
		width: 3.25rem;
		border-top: 2px solid var(--text-3);
		content: '';
	}

	.architecture-entry--azure::before {
		border-color: var(--azure);
	}

	.architecture-entry--gcp::before {
		border-color: var(--gcp);
	}

	.architecture-entry--compare::before {
		height: 2px;
		border: 0;
		background: linear-gradient(90deg, var(--azure) 0 50%, var(--gcp) 50%);
	}

	.architecture-entry--linked {
		transition: background 160ms ease;
	}

	.architecture-entry--linked:hover {
		background: var(--surface);
		text-decoration: none;
	}

	:where(.architecture-entry--linked:hover) .architecture-entry__arrow {
		transform: translateX(0.25rem);
	}

	.architecture-entry__index {
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
	}

	.architecture-entry__provider {
		display: grid;
		gap: 0.3rem;
	}

	.architecture-entry__provider strong {
		font-size: 0.9375rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.architecture-entry--azure .architecture-entry__provider strong {
		color: var(--azure);
	}

	.architecture-entry--gcp .architecture-entry__provider strong {
		color: var(--gcp);
	}

	.architecture-entry--compare .architecture-entry__provider strong {
		background: linear-gradient(90deg, var(--azure), var(--gcp));
		background-clip: text;
		color: transparent;
	}

	.architecture-entry__provider span,
	.architecture-entry__body p {
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	h3 {
		margin: 0 0 0.35rem;
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 2vw, 1.55rem);
		letter-spacing: -0.025em;
		line-height: 1.45;
	}

	.architecture-entry__body p {
		margin: 0;
	}

	.architecture-entry__status {
		color: var(--text-2);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		white-space: nowrap;
		font-weight: 700;
		text-align: right;
	}

	.architecture-entry__arrow {
		font-size: 1.1rem;
		transition: transform 160ms ease;
	}

	@media (max-width: 720px) {
		.architecture-entry {
			grid-template-columns: 2.5rem minmax(0, 1fr) auto;
			gap: 0.5rem 0.75rem;
			min-height: 7.5rem;
			padding-block: 0.9rem;
		}

		.architecture-entry::before {
			width: 2.5rem;
		}

		.architecture-entry__index {
			grid-row: 1 / span 2;
			align-self: start;
			padding-top: 0.15rem;
		}

		.architecture-entry__provider {
			grid-column: 2;
			grid-row: 1;
		}

		.architecture-entry__body {
			grid-column: 2 / -1;
			grid-row: 2;
		}

		.architecture-entry__status {
			grid-column: 3;
			grid-row: 1;
		}

		.architecture-entry__arrow {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.architecture-entry--linked,
		.architecture-entry__arrow {
			transition: none;
		}
	}
</style>
