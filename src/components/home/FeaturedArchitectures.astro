---
import type { ArchitectureSummary } from '../../data/architectures';
import ArchitectureCard from '../architecture/ArchitectureCard.astro';

interface Props {
	items: ArchitectureSummary[];
}

const { items } = Astro.props;
const publishedCount = items.filter((item) => item.detailId).length;
---

<section id="architecture-index" class="featured" aria-labelledby="featured-title">
	<div class="container">
		<header class="featured__header">
			<div>
				<p class="featured__label">Architecture index</p>
				<h2 id="featured-title">ケーススタディ（アーキテクチャ）一覧</h2>
			</div>
			<p class="featured__coverage">
				<strong>{publishedCount} / {items.length}</strong>
				<span>ケーススタディ公開中</span>
			</p>
		</header>
		<p class="featured__intro">
			クラウドサービスの構成をケーススタディとして掲載しています。公開済みのテーマは設計判断・コスト・コードまで、詳細のないテーマは現在確認できる範囲を「概要のみ」として読めます。
		</p>
		<div class="featured__list">
			{items.map((architecture, index) => (
				<ArchitectureCard architecture={architecture} position={index + 1} />
			))}
		</div>
	</div>
</section>

<style>
	.featured {
		padding: clamp(3.25rem, 6vw, 5.5rem) 0;
	}

	.featured__header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid var(--text);
		padding-bottom: 1.5rem;
	}

	.featured__label {
		margin: 0 0 0.65rem;
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.9rem, 4vw, 3.25rem);
		letter-spacing: -0.045em;
		line-height: 1.25;
	}

	.featured__coverage {
		display: grid;
		flex: 0 0 auto;
		margin: 0;
		text-align: right;
	}

	.featured__coverage strong {
		font-family: var(--font-mono);
		font-size: 1.25rem;
		line-height: 1.2;
	}

	.featured__coverage span {
		color: var(--text-3);
		font-size: 0.8125rem;
	}

	.featured__intro {
		max-width: 50rem;
		margin: 1.25rem 0 1.75rem;
		color: var(--text-2);
		font-size: 1rem;
		line-height: 1.85;
	}

	.featured__list {
		border-top: 1px solid var(--border);
	}

	@media (max-width: 720px) {
		.featured__header {
			align-items: start;
			flex-direction: column;
			gap: 1rem;
		}

		.featured__coverage {
			display: flex;
			align-items: baseline;
			gap: 0.65rem;
			text-align: left;
		}
	}
</style>
