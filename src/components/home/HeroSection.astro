---
import type { CollectionEntry } from 'astro:content';
import type {
	ArchitectureSummary,
	HeroCaseStudyConfig,
} from '../../data/architectures';
import { getLatestArchitectureSourceUrl } from '../../utils/architecture-source';

interface Props {
	architecture: ArchitectureSummary;
	entry: CollectionEntry<'architectureDetails'>;
	architectureCount: number;
	spotlight: HeroCaseStudyConfig;
}

const { architecture, entry, architectureCount, spotlight } = Astro.props;
const detailUrl = `/architectures/${architecture.detailId}/`;
const sourceUrl = getLatestArchitectureSourceUrl(entry.data.source);
const providerLabel = entry.data.source.provider === 'gcp' ? 'Google Cloud' : 'Azure';
---

<section class="hero" aria-labelledby="home-title">
	<div class="hero__grid container">
		<header class="hero__intro">
			<p class="hero__catalog-label">Cloud Architecture Lab / Case study catalog</p>
			<h1 id="home-title">
				<span>クラウド設計の</span>
				<span>ケーススタディ集</span>
			</h1>
			<p class="hero__lead">
				実際の構成図を起点に、要件・設計判断・コスト・コードを公開するアーキテクチャカタログです。
			</p>
			<a class="hero__index-link" href="#architecture-index">
				全{architectureCount}テーマを一覧で見る <span aria-hidden="true">↓</span>
			</a>
		</header>

		<section class="hero__featured" aria-labelledby="published-case-title">
			<header class="hero__featured-heading">
				<p><span aria-hidden="true"></span> {spotlight.label}</p>
				<p>{spotlight.description}</p>
			</header>

			<figure class="hero__plate">
				<figcaption class="hero__plate-heading">
					<span>構成図</span>
					<strong>{providerLabel} / Web公開アーキテクチャ</strong>
				</figcaption>
				<div class="hero__diagram">
					<img
						src={entry.data.diagram.src}
						width={entry.data.diagram.width}
						height={entry.data.diagram.height}
						alt={entry.data.diagramAlt}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
			</figure>

			<aside class="hero__case">
				<p class="hero__case-meta">{providerLabel} / Web公開アーキテクチャ</p>
				<h2 id="published-case-title">{architecture.title}</h2>
				<p class="hero__case-description">{entry.data.description}</p>
				<div class="hero__services-group">
					<p>利用サービス</p>
					<ul class="hero__services" aria-label="このケースで利用するサービス">
						{architecture.services.map((service) => <li>{service}</li>)}
					</ul>
				</div>
				<div class="hero__source">
					<a href={sourceUrl} target="_blank" rel="noopener noreferrer">
						<span>GitHubで最新の実装を見る</span>
						<span class="sr-only">（新しいタブで開く）</span>
					</a>
				</div>
				<a class="hero__primary-action" href={detailUrl}>
					このケーススタディを読む <span aria-hidden="true">→</span>
				</a>
			</aside>
		</section>
	</div>
</section>

<style>
	.hero {
		padding: clamp(2.75rem, 5vw, 4.75rem) 0 clamp(2.5rem, 5vw, 4.5rem);
		border-bottom: 1px solid var(--border);
	}

	.hero__grid {
		display: grid;
		grid-template-columns: minmax(18rem, 0.82fr) minmax(0, 2.18fr);
		gap: clamp(1.5rem, 3vw, 3rem);
		align-items: center;
	}

	.hero__catalog-label,
	.hero__featured-heading,
	.hero__plate-heading,
	.hero__source {
		font-family: var(--font-mono);
	}

	.hero__catalog-label {
		margin: 0;
		color: var(--text-3);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	h1 {
		margin: 1rem 0 1.15rem;
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 3vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.065em;
		line-height: 1.13;
		text-wrap: balance;
	}

	h1 span {
		display: block;
		white-space: nowrap;
	}

	.hero__lead {
		margin: 0;
		color: var(--text-2);
		font-size: 1.0625rem;
		line-height: 1.85;
	}

	.hero__index-link {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		margin-top: 1.5rem;
		border-bottom: 1px solid var(--text);
		padding-bottom: 0.3rem;
		color: var(--text);
		font-size: 0.9375rem;
		font-weight: 700;
		text-decoration: none;
	}

	.hero__index-link:hover {
		color: var(--gcp);
		text-decoration: none;
	}

	.hero__featured {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(20rem, 0.95fr);
		gap: 1.25rem clamp(1.25rem, 2.5vw, 2rem);
		min-width: 0;
	}

	.hero__featured-heading {
		display: flex;
		grid-column: 1 / -1;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-top: 1px solid color-mix(in srgb, var(--gcp) 48%, var(--border));
		border-bottom: 1px solid color-mix(in srgb, var(--gcp) 48%, var(--border));
		padding: 0.65rem 0;
	}

	.hero__featured-heading p {
		margin: 0;
	}

	.hero__featured-heading p:first-child {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--gcp);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.hero__featured-heading p:first-child span {
		width: 0.6rem;
		height: 0.6rem;
		background: var(--gcp);
	}

	.hero__featured-heading p:last-child {
		color: var(--text-3);
		font-family: var(--font-body);
		font-size: 0.875rem;
		line-height: 1.5;
		text-align: right;
	}

	.hero__plate {
		position: relative;
		margin: 0;
		border: 1px solid var(--text);
		background: var(--surface);
		box-shadow: 0.7rem 0.7rem 0 var(--surface-2);
	}

	.hero__plate::before,
	.hero__plate::after {
		position: absolute;
		z-index: 1;
		width: 0.75rem;
		height: 0.75rem;
		border-color: var(--text);
		content: '';
		pointer-events: none;
	}

	.hero__plate::before {
		top: -0.3rem;
		left: -0.3rem;
		border-top: 1px solid;
		border-left: 1px solid;
	}

	.hero__plate::after {
		right: -0.3rem;
		bottom: -0.3rem;
		border-right: 1px solid;
		border-bottom: 1px solid;
	}

	.hero__plate-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid var(--border);
		padding: 0.75rem 0.8rem;
		color: var(--gcp);
		font-weight: 700;
		font-size: 0.75rem;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.hero__plate-heading strong {
		color: var(--text);
		font-family: var(--font-display);
		font-size: 0.9375rem;
		letter-spacing: -0.025em;
		line-height: 1.35;
		text-align: right;
		text-transform: none;
	}

	.hero__diagram {
		display: grid;
		min-height: 18rem;
		place-items: center;
		overflow: hidden;
		padding: 0.75rem;
	}

	.hero__diagram img {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero__case {
		border-left: 1px solid var(--border);
		padding-left: clamp(1.25rem, 2.5vw, 2rem);
	}

	.hero__case-meta {
		margin: 0 0 0.8rem;
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.hero__case h2 {
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 2.35vw, 2.15rem);
		letter-spacing: -0.035em;
		line-height: 1.35;
	}

	.hero__case-description {
		margin: 0;
		color: var(--text-2);
		font-size: 1rem;
		line-height: 1.85;
	}

	.hero__services-group {
		margin-top: 1.25rem;
	}

	.hero__services-group > p {
		margin: 0 0 0.55rem;
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.hero__services {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--gcp);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.hero__services li {
		border: 1px solid color-mix(in srgb, var(--gcp) 42%, var(--border));
		background: var(--gcp-bg);
		padding: 0.2rem 0.45rem;
		line-height: 1.45;
	}

	.hero__source {
		border-top: 1px solid var(--border);
		padding-top: 1rem;
	}

	.hero__source a {
		display: grid;
		width: fit-content;
		gap: 0.1rem;
		color: var(--text);
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
	}

	.hero__source a:hover {
		color: var(--gcp);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.hero__primary-action {
		display: flex;
		min-height: 3.25rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 1.5rem;
		border: 1px solid var(--text);
		background: var(--text);
		padding: 0.75rem 0.9rem;
		color: var(--surface);
		font-size: 0.9375rem;
		font-weight: 700;
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease;
	}

	.hero__primary-action:hover {
		background: transparent;
		color: var(--text);
		text-decoration: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 1039px) {
		.hero__grid {
			grid-template-columns: minmax(0, 1fr);
			align-items: stretch;
		}

		.hero__intro {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
			gap: 0.75rem 2rem;
			align-items: end;
		}

		.hero__catalog-label {
			grid-column: 1 / -1;
		}

		h1 {
			margin-bottom: 0;
		}

		.hero__lead {
			padding-bottom: 0.3rem;
		}

	}

	@media (max-width: 720px) {
		.hero {
			padding-top: 2.75rem;
		}

		.hero__grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 2rem;
		}

		.hero__intro {
			display: block;
		}

		h1 {
			margin: 0.85rem 0 1.15rem;
			font-size: clamp(2rem, 11vw, 2.75rem);
		}

		.hero__featured {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.5rem;
		}

		.hero__featured-heading {
			display: grid;
			gap: 0.3rem;
		}

		.hero__featured-heading p:last-child {
			text-align: left;
		}

		.hero__case {
			order: 2;
			border-top: 1px solid var(--border);
			border-left: 0;
			padding-top: 1.5rem;
			padding-left: 0;
		}

		.hero__plate {
			order: 3;
			box-shadow: 0.4rem 0.4rem 0 var(--surface-2);
		}

		.hero__diagram {
			min-height: 0;
			padding: 0.35rem;
		}

		.hero__plate-heading {
			align-items: start;
			flex-direction: column;
			gap: 0.2rem;
		}

		.hero__plate-heading strong {
			text-align: left;
		}

		.hero__case-description {
			max-width: 38rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__primary-action {
			transition: none;
		}
	}
</style>
