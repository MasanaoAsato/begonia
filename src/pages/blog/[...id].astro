---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	type BlogPostEntry,
	formatBlogPostDate,
	getBlogPostsForBuild,
} from '../../utils/blog-posts';

type PageProps = {
	entry: BlogPostEntry;
};

export async function getStaticPaths() {
	const entries = await getCollection('blogPosts');
	const visibleEntries = getBlogPostsForBuild(entries, import.meta.env.PROD);

	return visibleEntries.map((entry) => ({
		params: { id: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props as PageProps;
const { Content } = await render(entry);
const publishedDate = formatBlogPostDate(entry.data.publishedAt);
---

<BaseLayout
	title={`${entry.data.title} | Cloud Architecture Lab`}
	description={entry.data.description}
>
	<article class="blog-post">
		<div class="container">
			<nav class="blog-post__breadcrumb" aria-label="パンくず">
				<a href="/">Cloud Architecture Lab</a>
				<span aria-hidden="true">/</span>
				<a href="/#blog-index">ブログ記事</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{entry.data.title}</span>
			</nav>

			<header class="blog-post__header">
				<ul class="blog-post__tags" aria-label="記事のタグ">
					{entry.data.tags.map((tag) => <li>{tag}</li>)}
				</ul>
				<time
					class="blog-post__date"
					datetime={entry.data.publishedAt.toISOString()}
				>
					公開日: {publishedDate}
				</time>
				<h1>{entry.data.title}</h1>
				<p class="blog-post__intro">{entry.data.description}</p>
			</header>

			<div class="blog-post__body">
				<div class="blog-post__prose">
					<Content />
				</div>
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.blog-post {
		padding: 1.5rem 0 4rem;
	}

	.blog-post__breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		align-items: center;
		margin-bottom: 3.5rem;
		color: var(--text-3);
		font-size: 0.875rem;
	}

	.blog-post__breadcrumb a {
		color: var(--text-2);
		font-weight: 600;
	}

	.blog-post__breadcrumb a:hover {
		color: var(--accent);
	}

	.blog-post__header {
		max-width: 52rem;
		margin: 0 auto 2.75rem;
	}

	.blog-post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0 0 1rem;
		padding: 0;
		list-style: none;
	}

	.blog-post__tags li {
		border-radius: var(--radius);
		background: var(--surface-2);
		padding: 0.25rem 0.7rem;
		color: var(--text-2);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.blog-post__date {
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
	}

	h1 {
		max-width: 44rem;
		margin: 0.6rem 0 1rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		letter-spacing: -0.045em;
		line-height: 1.12;
	}

	.blog-post__intro {
		max-width: 43rem;
		margin: 0;
		color: var(--text-2);
		font-size: 1.05rem;
		line-height: 1.85;
	}

	.blog-post__body {
		max-width: 44rem;
		margin: 0 auto;
	}

	.blog-post__prose {
		min-width: 0;
	}

	.blog-post__prose :global(h2) {
		margin: 0 0 1rem;
		padding-top: 0.25rem;
		font-size: clamp(1.35rem, 3vw, 1.7rem);
		line-height: 1.35;
	}

	.blog-post__prose :global(h2:not(:first-child)) {
		margin-top: 4rem;
	}

	.blog-post__prose :global(h3) {
		margin: 2rem 0 0.7rem;
		font-size: 1.05rem;
		line-height: 1.45;
	}

	.blog-post__prose :global(p),
	.blog-post__prose :global(ul),
	.blog-post__prose :global(ol) {
		margin: 0 0 1rem;
	}

	.blog-post__prose :global(ul),
	.blog-post__prose :global(ol) {
		padding-left: 1.35rem;
	}

	.blog-post__prose :global(li + li) {
		margin-top: 0.45rem;
	}

	.blog-post__prose :global(code) {
		border-radius: 0.25rem;
		background: var(--surface-2);
		padding: 0.08rem 0.32rem;
		font-size: 0.9em;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.blog-post__prose :global(pre) {
		overflow-x: auto;
		border: 1px solid var(--border);
		background: var(--surface-2);
		padding: 1rem;
	}

	.blog-post__prose :global(pre code) {
		background: transparent;
		padding: 0;
	}

	.blog-post__prose :global(table) {
		width: 100%;
		margin: 1.5rem 0;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}

	.blog-post__prose :global(th),
	.blog-post__prose :global(td) {
		border: 1px solid var(--border);
		padding: 0.7rem;
		text-align: left;
		vertical-align: top;
	}

	.blog-post__prose :global(th) {
		background: var(--surface-2);
		font-weight: 700;
	}

	.blog-post__prose :global(a) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.blog-post__breadcrumb a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	@media (max-width: 720px) {
		.blog-post {
			padding-top: 1rem;
		}

		.blog-post__breadcrumb {
			margin-bottom: 2.5rem;
		}

		.blog-post__prose :global(table) {
			display: block;
			overflow-x: auto;
			white-space: nowrap;
		}
	}
</style>
