---
import { getCollection } from 'astro:content';
import FeaturedArchitectures from '../components/home/FeaturedArchitectures.astro';
import HeroSection from '../components/home/HeroSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
	getArchitectureSummary,
	sortArchitectureEntries,
	validateArchitectureEntries,
} from '../utils/architectures';

const entries = await getCollection('architectureDetails');
validateArchitectureEntries(entries);

const featuredArchitectures = sortArchitectureEntries(
	entries.filter((entry) => entry.data.featured),
).map(getArchitectureSummary);
const spotlightEntry = entries.find((entry) => entry.data.spotlight);

if (!spotlightEntry) {
	throw new Error('注目のケーススタディがありません。');
}
---

<BaseLayout
	title="Cloud Architecture Lab — Masanao Asato"
	description="クラウドサービスのアーキテクチャを、要件・設計判断・コスト・Terraform・本番化との差分までケーススタディとして公開しています。"
>
	<HeroSection
		architecture={getArchitectureSummary(spotlightEntry)}
		entry={spotlightEntry}
		architectureCount={featuredArchitectures.length}
	/>
	<FeaturedArchitectures items={featuredArchitectures} />
</BaseLayout>
