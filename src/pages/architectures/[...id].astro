---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLatestArchitectureSourceUrl } from '../../utils/architecture-source';
import {
	type ArchitectureDetailEntry,
	caseStudyHeadings,
	getArchitectureSummary,
	getCloudLabel,
	getThemeLabel,
	validateArchitectureEntries,
} from '../../utils/architectures';

type PageProps = {
	entry: ArchitectureDetailEntry;
};

export async function getStaticPaths() {
	const entries = await getCollection('architectureDetails');
	validateArchitectureEntries(entries);

	for (const entry of entries) {
		const { headings } = await render(entry);
		const actualHeadings = headings
			.filter((heading) => heading.depth === 2)
			.map((heading) => heading.text);
		if (JSON.stringify(actualHeadings) !== JSON.stringify(caseStudyHeadings)) {
			throw new Error(`必須見出しの順序が不正です: ${entry.id}`);
		}
	}

	return entries.map((entry) => ({
			params: { id: entry.id },
			props: { entry },
		}));
}

const { entry } = Astro.props as PageProps;
const architecture = getArchitectureSummary(entry);
const { Content } = await render(entry);
const cloudLabel = getCloudLabel(architecture.cloud);
const sourceUrl = getLatestArchitectureSourceUrl(entry.data.source);
---

<BaseLayout
	title={`${architecture.title} | Cloud Architecture Lab`}
	description={entry.data.description}
>
	<article class:list={['case-study', `case-study--${architecture.cloud}`]}>
		<div class="container">
			<nav class="case-study__breadcrumb" aria-label="パンくず">
				<a href="/">Cloud Architecture Lab</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{architecture.title}</span>
			</nav>

			<header class="case-study__header">
				<div class="case-study__badges">
					<span class="case-study__badge case-study__badge--provider">{cloudLabel}</span>
					{architecture.themes.map((theme) => (
						<span class="case-study__badge">{getThemeLabel(theme)}</span>
					))}
				</div>
				<p class="case-study__kicker">CASE STUDY / {entry.data.source.architectureId}</p>
				<h1>{architecture.title}</h1>
				<p class="case-study__intro">{entry.data.description}</p>
				<ul class="case-study__services" aria-label="利用サービス">
					{architecture.services.map((service) => <li>{service}</li>)}
				</ul>
			</header>

			<figure class="case-study__diagram">
				<div class="case-study__diagram-frame">
					<img
						src={entry.data.diagram}
						alt={entry.data.diagramAlt}
					/>
				</div>
				<figcaption>公開経路の全体像。実装は出典リポジトリの最新コードで確認できます。</figcaption>
			</figure>

			<div class="case-study__body">
				<aside class="case-study__toc" aria-label="このケーススタディの構成">
					<p>READING MAP</p>
					<ol>
						{caseStudyHeadings.map((heading, index) => (
							<li>
								<span>{String(index + 1).padStart(2, '0')}</span>
								{heading}
							</li>
						))}
					</ol>
				</aside>
				<div class="case-study__prose">
					<Content />
				</div>
			</div>

			<footer class="case-study__source">
				<div>
					<p class="case-study__source-label">GITHUB / MAIN</p>
					<p>このケースの最新の実装とREADMEを確認できます。</p>
				</div>
				<a href={sourceUrl} target="_blank" rel="noopener noreferrer">
					GitHubで最新の実装を見る <span aria-hidden="true">↗</span>
				</a>
			</footer>
		</div>
	</article>
</BaseLayout>

<style>
	.case-study--gcp {
		--case-accent: var(--gcp);
		--case-accent-bg: var(--gcp-bg);
	}

	.case-study--azure {
		--case-accent: var(--azure);
		--case-accent-bg: var(--azure-bg);
	}

	.case-study {
		padding: 1.5rem 0 4rem;
	}

	.case-study__breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		align-items: center;
		margin-bottom: 3.5rem;
		color: var(--text-3);
		font-size: 0.875rem;
	}

	.case-study__breadcrumb a {
		color: var(--text-2);
		font-weight: 600;
	}

	.case-study__breadcrumb a:hover {
		color: var(--case-accent);
	}

	.case-study__header {
		max-width: 52rem;
		margin-bottom: 2.75rem;
	}

	.case-study__badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-bottom: 1rem;
	}

	.case-study__badge {
		border-radius: var(--radius);
		background: var(--surface-2);
		padding: 0.25rem 0.7rem;
		color: var(--text-2);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.case-study__badge--provider {
		background: var(--case-accent-bg);
		color: var(--case-accent);
	}

	.case-study__kicker,
	.case-study__source-label {
		margin: 0;
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	h1 {
		max-width: 44rem;
		margin: 0.6rem 0 1rem;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		letter-spacing: -0.045em;
		line-height: 1.12;
	}

	.case-study__intro {
		max-width: 43rem;
		margin: 0;
		color: var(--text-2);
		font-size: 1.05rem;
		line-height: 1.85;
	}

	.case-study__services {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		color: var(--text-3);
		font-size: 0.9375rem;
	}

	.case-study__services li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.case-study__services li::before {
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 50%;
		background: var(--case-accent);
		content: '';
	}

	.case-study__diagram {
		margin: 0 0 4rem;
	}

	.case-study__diagram-frame {
		display: grid;
		place-items: center;
		min-height: 18rem;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: 0.65rem 0.65rem 0 var(--surface-2);
	}

	.case-study__diagram img {
		display: block;
		width: 100%;
		height: auto;
	}

	.case-study__diagram figcaption {
		margin-top: 0.75rem;
		color: var(--text-3);
		font-size: 0.875rem;
	}

	.case-study__body {
		display: grid;
		grid-template-columns: minmax(10rem, 14rem) minmax(0, 44rem);
		gap: clamp(2rem, 6vw, 5rem);
		align-items: start;
		justify-content: center;
	}

	.case-study__toc {
		position: sticky;
		top: 5rem;
		font-size: 0.875rem;
	}

	.case-study__toc p {
		margin: 0 0 0.75rem;
		color: var(--text-3);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.case-study__toc ol {
		display: grid;
		gap: 0.65rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.case-study__toc li {
		display: grid;
		grid-template-columns: 1.5rem 1fr;
		gap: 0.5rem;
		color: var(--text-3);
		line-height: 1.45;
	}

	.case-study__toc li span {
		color: var(--case-accent);
		font-variant-numeric: tabular-nums;
	}

	.case-study__prose {
		min-width: 0;
	}

	.case-study__prose :global(h2) {
		margin: 0 0 1rem;
		padding-top: 0.25rem;
		font-size: clamp(1.35rem, 3vw, 1.7rem);
		line-height: 1.35;
	}

	.case-study__prose :global(h2:not(:first-child)) {
		margin-top: 4rem;
	}

	.case-study__prose :global(h3) {
		margin: 2rem 0 0.7rem;
		font-size: 1.05rem;
		line-height: 1.45;
	}

	.case-study__prose :global(p),
	.case-study__prose :global(ul),
	.case-study__prose :global(ol) {
		margin: 0 0 1rem;
	}

	.case-study__prose :global(ul),
	.case-study__prose :global(ol) {
		padding-left: 1.35rem;
	}

	.case-study__prose :global(li + li) {
		margin-top: 0.45rem;
	}

	.case-study__prose :global(code) {
		border-radius: 0.25rem;
		background: var(--surface-2);
		padding: 0.08rem 0.32rem;
		font-size: 0.9em;
		overflow-wrap: anywhere;
		word-break: break-word;
	}

	.case-study__prose :global(table) {
		width: 100%;
		margin: 1.5rem 0;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}

	.case-study__prose :global(th),
	.case-study__prose :global(td) {
		border: 1px solid var(--border);
		padding: 0.7rem;
		text-align: left;
		vertical-align: top;
	}

	.case-study__prose :global(th) {
		background: var(--surface-2);
		font-weight: 700;
	}

	.case-study__prose :global(a) {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	.case-study__source {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin: 4rem auto 0;
		border-top: 1px solid var(--border);
		padding-top: 1.25rem;
		max-width: 58rem;
		color: var(--text-3);
		font-size: 0.9375rem;
	}

	.case-study__source p:not(.case-study__source-label) {
		margin: 0.25rem 0 0;
	}

	.case-study__source a {
		flex: 0 0 auto;
		border-bottom: 1px solid currentColor;
		padding-bottom: 0.15rem;
		color: var(--case-accent);
		font-weight: 700;
	}

	.case-study__source a:hover {
		text-decoration: none;
	}

	.case-study__source a:focus-visible,
	.case-study__breadcrumb a:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	@media (max-width: 720px) {
		.case-study {
			padding-top: 1rem;
		}

		.case-study__breadcrumb {
			margin-bottom: 2.5rem;
		}

		.case-study__body {
			display: block;
		}

		.case-study__toc {
			position: static;
			margin-bottom: 2.5rem;
		border-left: 2px solid var(--case-accent);
			padding-left: 1rem;
		}

		.case-study__toc ol {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.case-study__prose :global(table) {
			display: block;
			overflow-x: auto;
			white-space: nowrap;
		}

		.case-study__source {
			align-items: flex-start;
			flex-direction: column;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.case-study__source a {
			transition: none;
		}
	}
</style>
